DATABASE_URL=postgresql://cs2:cs2@db:5432/cs2_analyzer
UPLOAD_DIR=uploads
DEMO_RETENTION_DAYS=7
TRUSTED_HOSTS=*
CORS_ORIGINS=*

# --- Demo storage (S3 / MinIO) ---
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PREFIX=demos
S3_FORCE_PATH_STYLE=false
S3_DELETE_LOCAL_AFTER_UPLOAD=true
S3_DELETE_LOCAL_AFTER_PARSE=true
S3_CLEANUP_ENABLED=true
